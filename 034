#include <stdio.h>

int conta(const char s[], char c, int i) {
    if (s[i] == '\0') {
        return 0;
    }
    if (s[i] == c) {
        return 1 + conta(s, c, i + 1);
    }
    return conta(s, c, i + 1);
}

int main() {
    char s[100], c;
    scanf("%s %c", s, &c);
    printf("%d\n", conta(s, c, 0));
    return 0;
}
