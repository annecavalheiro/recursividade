#include <stdio.h>

long long fibMemo(int n, long long memo[]) {
    if (n <= 1) {
        return n;
    }
    if (memo[n] != -1) {
        return memo[n];
    }
    memo[n] = fibMemo(n - 1, memo) + fibMemo(n - 2, memo);
    return memo[n];
}

long long fib(int n) {
    long long memo[100];
    for (int i = 0; i <= n; i++) {
        memo[i] = -1;
    }
    return fibMemo(n, memo);
}

int main() {
    int n;
    scanf("%d", &n);
    printf("%lld\n", fib(n));
    return 0;
}
