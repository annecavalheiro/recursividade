#include <stdio.h>

int ordenado(int v[], int n) {
    if (n <= 1) {
        return 1;
    }
    if (v[n - 2] > v[n - 1]) {
        return 0;
    }
    return ordenado(v, n - 1);
}

int main() {
    int n;
    scanf("%d", &n);
    
    int v[n];
    for (int i = 0; i < n; i++) {
        scanf("%d", &v[i]);
    }
    
    printf("%d\n", ordenado(v, n));
    return 0;
}
