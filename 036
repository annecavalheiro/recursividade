#include <stdio.h>

void inverteVetor(int v[], int ini, int fim) {
    if (ini >= fim) {
        return;
    }
    int temp = v[ini];
    v[ini] = v[fim];
    v[fim] = temp;
    inverteVetor(v, ini + 1, fim - 1);
}

int main() {
    int n;
    scanf("%d", &n);
    
    int v[n];
    for (int i = 0; i < n; i++) {
        scanf("%d", &v[i]);
    }
    
    inverteVetor(v, 0, n - 1);
    
    for (int i = 0; i < n; i++) {
        printf("%d ", v[i]);
    }
    printf("\n");
    return 0;
}
