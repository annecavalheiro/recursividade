#include <stdio.h>

int menor(int v[], int n) {
    if (n == 1) {
        return v[0];
    }
    int m = menor(v, n - 1);
    return (v[n - 1] < m) ? v[n - 1] : m;
}

int main() {
    int n;
    scanf("%d", &n);
    
    int v[n];
    for (int i = 0; i < n; i++) {
        scanf("%d", &v[i]);
    }
    
    printf("%d\n", menor(v, n));
    return 0;
}
