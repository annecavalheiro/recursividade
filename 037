#include <stdio.h>

int busca(int v[], int ini, int fim, int x) {
    if (ini > fim) {
        return -1;
    }
    int meio = ini + (fim - ini) / 2;
    if (v[meio] == x) {
        return meio;
    }
    if (v[meio] > x) {
        return busca(v, ini, meio - 1, x);
    }
    return busca(v, meio + 1, fim, x);
}

int main() {
    int n, x;
    scanf("%d", &n);
    
    int v[n];
    for (int i = 0; i < n; i++) {
        scanf("%d", &v[i]);
    }
    
    scanf("%d", &x);
    printf("%d\n", busca(v, 0, n - 1, x));
    return 0;
}
